{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "parts", "summary", "not_covered"],
  "properties": {
    "title": { "type": "string" },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "steps"],
        "properties": {
          "title": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "hunks", "weight", "points", "notes"],
              "properties": {
                "title": { "type": "string" },
                "hunks": { "type": "array", "items": { "type": "string" } },
                "weight": { "type": "string", "enum": ["key", "normal", "skim"] },
                "points": { "type": "array", "items": { "type": "string" } },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "text"],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": ["decision", "upkeep", "limitation", "divergence", "untested"]
                      },
                      "text": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "summary": { "type": "string" },
    "not_covered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "note"],
        "properties": {
          "path": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
